# Bu faylni nusxalab ".env" nomi bilan saqlang va backend serveringiz manzilini kiriting.
# ".env" fayli hech qachon git'ga qo'shilmasligi kerak (.gitignore da allaqachon bor).

# Lokal ishlab chiqish uchun:
# REACT_APP_API_URL=http://localhost:3003

# Production uchun (backend deploy qilingan manzil):
REACT_APP_API_URL=https://your-backend-domain.com
